# Copy to .env and fill in. NEVER commit .env.
# Every secret in this system comes from here and from nowhere else:
# not from YAML, not from the database, not from code. (Rule R4.)

# This file is read from beside the code, NOT from the directory you happen to start
# qorgan in. Copy it to .env next to pyproject.toml and nowhere else -- a .env somewhere
# else is not read, and the process starts on the defaults below without saying so.

# --- Web ---
# dev | prod. prod requires WEB_HTTPS=true (see below) and refuses to start without it.
QORGAN_ENV=dev
# 127.0.0.1 keeps the dashboard on this machine. Reaching it from other computers on the
# school network means 0.0.0.0 -- which serves children's photographs and live video to
# the LAN, so SECRET_KEY below must be a real one. qorgan refuses to start otherwise.
WEB_HOST=127.0.0.1
WEB_PORT=8000
# Is the dashboard really served over HTTPS -- directly, or behind a proxy terminating
# TLS? This alone decides whether the session cookie is marked Secure. Setting it true
# while serving plain http:// means the browser will not send the cookie back and login
# will loop; setting it false while serving https:// only loses a hardening flag.
WEB_HTTPS=false
# Signs session cookies. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
# The built-in default is published in settings.py: anyone who has read the source can
# forge an operator session with it. It is accepted on loopback in dev, nowhere else.
SECRET_KEY=change-me-to-a-long-random-string

# --- Camera credentials (RTSP) ---
# Default for every camera:
RTSP_USER=admin
RTSP_PASSWORD=change-me
# Optional per-camera override; the suffix is the camera name upper-cased:
# RTSP_USER__HALL_LEFT=admin
# RTSP_PASSWORD__HALL_LEFT=different-password-per-nvr

# --- Telegram ---
# Leave blank to disable notifications entirely.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Storage ---
DATABASE_URL=sqlite+pysqlite:///./data/qorgan.sqlite3
MEDIA_ROOT=./media
LOG_DIR=./logs
CONFIG_DIR=./config

# --- Live preview (workers PUB, the web process SUBs) ---
# LOOPBACK ONLY, and not by accident: these are frames of children. Binding this to
# 0.0.0.0 or a LAN address publishes live video of a school corridor to the network
# with no authentication in front of it -- the dashboard's login does not guard this
# socket. Change it only to move the port.
PREVIEW_ADDRESS=tcp://127.0.0.1:5556
# How long a preview frame stays "live" before the dashboard calls it stale. Raising it
# means the operator can be shown a frame older than it looks.
PREVIEW_STALE_AFTER_SECONDS=10.0

# --- Locale ---
# All timestamps are stored UTC; this is the school's local day boundary,
# used by "who did not eat today" style reports.
SCHOOL_TIMEZONE=Asia/Almaty

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true
